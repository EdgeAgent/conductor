{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "Conductor"
  },
  "author": "EdgeAgent",
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "js": [
        "src/detect.js",
        "src/lens.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "src/lib.js",
        "src/lens-bridge.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "src/lib.js",
        "src/page.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Turn any website into MCP tools and drive it by chat. Reads run free, writes ask first. Local-first with Ollama.",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Conductor \u2014 AI Browser Agent & MCP Tools",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "nativeMessaging"
  ],
  "short_name": "Conductor",
  "side_panel": {
    "default_path": "src/panel.html"
  },
  "version": "2.1.0"
}